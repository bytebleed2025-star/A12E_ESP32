{
  "name": "a12e-license-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Phone-assisted activation server for A12E Scale Monitor",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute a12e-license --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute a12e-license --remote --file=./schema.sql",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
