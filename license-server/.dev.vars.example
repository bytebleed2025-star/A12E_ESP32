# Copy this file to .dev.vars for local development.
# .dev.vars is gitignored and must never be committed.

SITE_NAME="A12E Scale Monitor (local)"
PRICE_LABEL="Rp 150.000 / device"
PAYMENT_INFO="Transfer to BCA 1234567890\nA/N Your Name\n\nSend the receipt to WhatsApp +62 8xx-xxxx-xxxx."
SUPPORT_CONTACT="WhatsApp: +62 8xx-xxxx-xxxx"

ADMIN_USER="admin"
ADMIN_PASSWORD="change-this-to-a-strong-password"

# Paste the private key as one line with \n escapes, or use a test keypair.
# The matching public key must be embedded in the firmware.
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
